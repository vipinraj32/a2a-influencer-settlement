# Copy to .env. Required to use the app: GOOGLE_OAUTH_CLIENT_ID/_SECRET, SESSION_SECRET, YOUTUBE_API_KEY.
# HSP + escrow fall back to the in-process simulation until real credentials are set (see /api/status).

# --- Sign-in: Google OAuth "Web application" client ---
# Authorized redirect URI: http://localhost:8000/auth/google/callback  (PUBLIC_BASE_URL + /auth/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Long random string: signs session cookies and encrypts influencer agent keys. Never change it after users sign up.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Where the browser lands after login. Dev with Vite: http://localhost:5173 ; empty = PUBLIC_BASE_URL
FRONTEND_URL=
# Bearer token for the stdio MCP server (read-only view of all campaigns); empty disables it
MCP_API_TOKEN=

# --- LLM (agents negotiate with Claude when set) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zyroxq

# --- Payments: PAYMENT_MODE (older name: SETTLEMENT_MODE) ---
#   simulated: in-process HSP emulator and escrow ledger, no tokens move
#   hosted:    real HSP QA gateway + checkout on HashKey Chain Testnet
#   sepolia:   real Circle test USDC on Ethereum Sepolia (chain 11155111) into CampaignEscrow; HSP is NOT in this path
# hosted refuses to start unless HSP_APP_KEY, HSP_APP_SECRET, the merchant key file, ESCROW_ADDRESS,
# OPERATOR_PRIVATE_KEY and VERIFIER_PRIVATE_KEY are set and the deployed escrow matches them. sepolia needs
# SEPOLIA_RPC_URL, ESCROW_ADDRESS, OPERATOR_PRIVATE_KEY and VERIFIER_PRIVATE_KEY. Neither ever falls back.
PAYMENT_MODE=simulated
APPROVAL_THRESHOLD_USD=50
PUBLIC_BASE_URL=http://localhost:8000

# --- HSP (HashKey Merchant) gateway, QA = testnet ---
HSP_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_APP_KEY=
HSP_APP_SECRET=
# Must match the merchant name registered with HSP (JWT iss/sub)
HSP_MERCHANT_NAME=ZyroXQ
HSP_MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
HSP_NETWORK=hashkey-testnet
HSP_COIN=USDC
# Only for scripts/smoke_hsp_order.py; the app pays into the escrow
HSP_PAY_TO=

# --- Chain (HashKey Chain Testnet, id 133) ---
HASHKEY_TESTNET_RPC_URL=https://testnet.hsk.xyz
# Set both to use the on-chain CampaignEscrow (scripts/deploy_escrow.py prints the address)
ESCROW_ADDRESS=
OPERATOR_PRIVATE_KEY=
HASHKEY_TESTNET_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# Signs proof attestations; must match the escrow's verifier. Advertisers sign payments in their own browser wallet.
VERIFIER_PRIVATE_KEY=
# --- Ethereum Sepolia (PAYMENT_MODE=sepolia) ---
# Server-side RPC (may carry a provider API key: never sent to the browser)
SEPOLIA_RPC_URL=
# What the browser wallet is told to use (public, shown in /api/status)
SEPOLIA_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
# Confirmations a settlement transaction needs before a deal counts as FUNDED
SETTLEMENT_MIN_CONFIRMATIONS=2

# --- Payment authorizations (EIP-3009) ---
# Lifetime of a drafted authorization, and the time it must have left when submitted
AUTHORIZATION_TTL_SECONDS=3600
AUTHORIZATION_MIN_REMAINING_SECONDS=120
# Submission timeout; a timeout marks the payment PAYMENT_UNKNOWN and reconciles, it never re-signs
HSP_SUBMIT_TIMEOUT_SECONDS=30

# --- Verifier: YouTube Data API v3 key (starts with "AIza"); required to verify posts ---
YOUTUBE_API_KEY=

# --- PostgreSQL (app data + LangGraph checkpoints); empty = in-memory ---
DATABASE_URL=
# Tests against a real database: TEST_DATABASE_URL=postgresql://zyroxq:zyroxq@localhost:5432/zyroxq_test
