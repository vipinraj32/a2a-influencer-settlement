# Copy to .env. Everything is optional for the local demo: unset values fall back to
# simulated HSP + escrow, demo keys, demo videos and rule-based negotiation (see /api/status).

# --- LLM (agents negotiate with Claude when set) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zyroxq

# --- Settlement: simulated (in-process HSP emulator) | hosted (real HSP QA gateway + checkout) ---
SETTLEMENT_MODE=simulated
APPROVAL_THRESHOLD_USD=50
PUBLIC_BASE_URL=http://localhost:8000

# --- HSP (HashKey Merchant) gateway, QA = testnet ---
HSP_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_APP_KEY=
HSP_APP_SECRET=
# Must match the merchant name registered with HSP (JWT iss/sub)
HSP_MERCHANT_NAME=ZyroXQ
HSP_MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
HSP_NETWORK=hashkey-testnet
HSP_COIN=USDC
# Only for scripts/smoke_hsp_order.py; the app pays into the escrow
HSP_PAY_TO=

# --- Chain (HashKey Chain Testnet, id 133) ---
HASHKEY_TESTNET_RPC_URL=https://testnet.hsk.xyz
# Set both to use the on-chain CampaignEscrow (scripts/deploy_escrow.py prints the address)
ESCROW_ADDRESS=
OPERATOR_PRIVATE_KEY=
# Payer wallet (Advertiser Agent) and proof verifier; demo keys are used when empty
ADVERTISER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# --- Verifier: YouTube Data API v3 key (starts with "AIza"); empty = demo videos ---
YOUTUBE_API_KEY=

# --- PostgreSQL (app data + LangGraph checkpoints); empty = in-memory ---
DATABASE_URL=
# Tests against a real database: TEST_DATABASE_URL=postgresql://zyroxq:zyroxq@localhost:5432/zyroxq_test
